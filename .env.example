# Server
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xtra
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_APP_URL=http://localhost:3000
# Super admin created on first run (npm run seed)
SUPER_ADMIN_EMAIL=admin@xtra.eg
SUPER_ADMIN_PASSWORD=change-me

# Paymob (leave empty to use the built-in test checkout)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# WhatsApp Cloud API (leave empty to log messages instead of sending)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Templates Meta has approved after launch (refund, waitlist, morning report). Comma separated.
WHATSAPP_NEW_TEMPLATES=

# Email via Resend (leave empty to log emails instead of sending)
RESEND_API_KEY=
EMAIL_FROM=XTRA <no-reply@xtra.eg>

# Google Wallet (optional)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
